rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create, read: if isSelf(userId);

      allow update: if isSelf(userId)
                    && request.resource.data.get('providerProgress', {})
                       == resource.data.get('providerProgress', {});

      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isSelf(userId);
      allow delete: if false;
    }

    match /appConfig/ratePolicy {
      allow read: if signedIn();
      allow write: if false;
    }

    match /serviceRateQuotes/{providerId} {
      allow read: if signedIn();

      allow create, update: if isSelf(providerId)
                            && request.resource.data.providerId == providerId
                            && request.resource.data.textPerMinute
                               == getAfter(/databases/$(database)/documents/users/$(providerId))
                                  .data.serviceRates.textPerMinute
                            && request.resource.data.audioPerMinute
                               == getAfter(/databases/$(database)/documents/users/$(providerId))
                                  .data.serviceRates.audioPerMinute
                            && request.resource.data.videoPerMinute
                               == getAfter(/databases/$(database)/documents/users/$(providerId))
                                  .data.serviceRates.videoPerMinute;

      allow delete: if false;
    }

    match /serviceRequests/{requestId} {
      allow create: if signedIn()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.providerId != request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.serviceType in ['text', 'audio', 'video']
                    && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.providerId))
                       .data.isAvailable == true
                    && (
                      (
                        request.resource.data.serviceType == 'text'
                        && request.resource.data.ratePerMinute
                           == get(/databases/$(database)/documents/serviceRateQuotes/$(request.resource.data.providerId))
                              .data.textPerMinute
                      )
                      ||
                      (
                        request.resource.data.serviceType == 'audio'
                        && request.resource.data.ratePerMinute
                           == get(/databases/$(database)/documents/serviceRateQuotes/$(request.resource.data.providerId))
                              .data.audioPerMinute
                      )
                      ||
                      (
                        request.resource.data.serviceType == 'video'
                        && request.resource.data.ratePerMinute
                           == get(/databases/$(database)/documents/serviceRateQuotes/$(request.resource.data.providerId))
                              .data.videoPerMinute
                      )
                    );

      allow read: if signedIn()
                  && (
                    resource.data.requesterId == request.auth.uid
                    || resource.data.providerId == request.auth.uid
                  );

      allow update: if signedIn()
                    && resource.data.providerId == request.auth.uid
                    && resource.data.status == 'pending'
                    && (
                      (
                        request.resource.data.status == 'declined'
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'respondedAt', 'updatedAt'])
                      )
                      ||
                      (
                        request.resource.data.status == 'accepted'
                        && request.resource.data.sessionId == requestId
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['status', 'respondedAt', 'updatedAt', 'sessionId'])
                      )
                    );

      allow delete: if false;
    }

    match /serviceSessions/{sessionId} {
      allow create: if signedIn()
                    && request.resource.data.requestId == sessionId
                    && request.resource.data.providerId == request.auth.uid
                    && request.resource.data.status == 'ready'
                    && request.resource.data.participants.size() == 2
                    && request.resource.data.participants.hasAll([
                      request.resource.data.requesterId,
                      request.resource.data.providerId
                    ])
                    && getAfter(/databases/$(database)/documents/serviceRequests/$(sessionId))
                       .data.status == 'accepted'
                    && getAfter(/databases/$(database)/documents/serviceRequests/$(sessionId))
                       .data.requesterId == request.resource.data.requesterId
                    && getAfter(/databases/$(database)/documents/serviceRequests/$(sessionId))
                       .data.providerId == request.resource.data.providerId
                    && getAfter(/databases/$(database)/documents/serviceRequests/$(sessionId))
                       .data.serviceType == request.resource.data.serviceType
                    && getAfter(/databases/$(database)/documents/serviceRequests/$(sessionId))
                       .data.ratePerMinute == request.resource.data.ratePerMinute;

      allow read: if signedIn()
                  && request.auth.uid in resource.data.participants;

      allow update: if signedIn()
                    && request.auth.uid in resource.data.participants
                    && (
                      (
                        resource.data.serviceType == 'text'
                        && (
                          (
                            request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly([
                                 'lastMessage',
                                 'lastMessageSenderId',
                                 'lastMessageAt',
                                 'lastMessageReadBy',
                                 'updatedAt'
                               ])
                            && request.resource.data.lastMessageSenderId == request.auth.uid
                            && request.resource.data.lastMessage is string
                            && request.resource.data.lastMessage.size() > 0
                            && request.resource.data.lastMessage.size() <= 4000
                            && request.resource.data.lastMessageReadBy == [request.auth.uid]
                          )
                          ||
                          (
                            request.resource.data.diff(resource.data).affectedKeys()
                               .hasOnly(['lastMessageReadBy', 'updatedAt'])
                            && request.resource.data.lastMessageReadBy
                               .hasAll(resource.data.get('lastMessageReadBy', []))
                            && request.resource.data.lastMessageReadBy
                               .hasAll([request.auth.uid])
                          )
                        )
                      )
                      ||
                      (
                        resource.data.serviceType in ['audio', 'video']
                        && resource.data.get('callStatus', 'active') == 'active'
                        && request.resource.data.callStatus == 'ended'
                        && request.resource.data.callEndedBy == request.auth.uid
                        && request.resource.data.callEndedAt != null
                        && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly([
                             'callStatus',
                             'callEndedBy',
                             'callEndedAt',
                             'updatedAt'
                           ])
                      )
                    );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                       .data.participants;

        allow create: if signedIn()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                         .data.participants
                      && get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                         .data.serviceType == 'text'
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 4000
                      && request.resource.data.deliveredAt == null
                      && request.resource.data.readAt == null
                      && request.resource.data.keys()
                         .hasOnly([
                           'senderId',
                           'text',
                           'sentAt',
                           'deliveredAt',
                           'readAt'
                         ]);

        allow update: if signedIn()
                      && request.auth.uid in
                         get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                         .data.participants
                      && resource.data.senderId != request.auth.uid
                      && request.resource.data.senderId == resource.data.senderId
                      && request.resource.data.text == resource.data.text
                      && request.resource.data.sentAt == resource.data.sentAt
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['deliveredAt', 'readAt'])
                      && request.resource.data.readAt != null;

        allow delete: if false;
      }

      match /ratings/{raterId} {
        allow read: if signedIn()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                       .data.participants;

        allow create: if signedIn()
                      && raterId == request.auth.uid
                      && request.resource.data.raterId == request.auth.uid
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.score is int
                      && request.resource.data.score >= 1
                      && request.resource.data.score <= 5
                      && request.resource.data.createdAt != null
                      && request.resource.data.keys().hasOnly([
                        'sessionId',
                        'raterId',
                        'ratedUserId',
                        'serviceType',
                        'score',
                        'createdAt'
                      ])
                      && request.auth.uid in
                         get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                         .data.participants
                      && get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                         .data.serviceType in ['audio', 'video']
                      && get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                         .data.callStatus == 'ended'
                      && request.resource.data.serviceType
                         == get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                            .data.serviceType
                      && request.resource.data.ratedUserId
                         in get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                            .data.participants
                      && request.resource.data.ratedUserId != request.auth.uid;

        allow update, delete: if false;
      }

      match /webrtc/{signalId} {
        allow read, create, update: if signedIn()
                                    && request.auth.uid in
                                       get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                                       .data.participants;
        allow delete: if false;

        match /requesterCandidates/{candidateId} {
          allow read, create: if signedIn()
                              && request.auth.uid in
                                 get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                                 .data.participants;
          allow update, delete: if false;
        }

        match /providerCandidates/{candidateId} {
          allow read, create: if signedIn()
                              && request.auth.uid in
                                 get(/databases/$(database)/documents/serviceSessions/$(sessionId))
                                 .data.participants;
          allow update, delete: if false;
        }
      }

    }
  }
}

